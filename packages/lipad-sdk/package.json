{
  "name": "lipad",
  "version": "0.1.0",
  "description": "Unified payments SDK for Kenya — Daraja, Jenga, Buni",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "tsc --noEmit"
  },
  "keywords": ["mpesa", "daraja", "jenga", "buni", "payments", "kenya", "fintech"],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.0",
    "async-mutex": "^0.4.0",
    "node-forge": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-forge": "^1.3.0",
    "tsup": "^8.0.0",
    "vitest": "^1.6.0"
  }
}

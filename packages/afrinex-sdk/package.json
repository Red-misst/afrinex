{
  "name": "afrinex",
  "version": "0.1.2",
  "description": "Unified payments SDK for Kenya — Safaricom M-Pesa (Daraja) and KCB (Buni)",
  "author": "Isaac Muigai",
  "license": "MIT",
  "homepage": "https://github.com/Red-misst/afrinex#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Red-misst/afrinex.git"
  },
  "bugs": {
    "url": "https://github.com/Red-misst/afrinex/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "keywords": [
    "mpesa",
    "daraja",
    "buni",
    "payments",
    "kenya",
    "fintech",
    "safaricom",
    "kcb",
    "mobile-money",
    "stk-push"
  ],
  "dependencies": {
    "axios": "^1.7.0",
    "async-mutex": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "vitest": "^1.6.0"
  }
}
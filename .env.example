# ── Daraja (Safaricom M-Pesa) ─────────────────────────────────────────────────
# Get these from https://developer.safaricom.co.ke/
AFRINEX_DARAJA_CONSUMER_KEY=        # Your App Consumer Key
AFRINEX_DARAJA_CONSUMER_SECRET=     # Your App Consumer Secret
AFRINEX_DARAJA_SHORTCODE=174379     # Sandbox shortcode (use your own in production)
AFRINEX_DARAJA_PASSKEY=             # STK push passkey from Safaricom portal

# ── Buni (KCB Bank) ──────────────────────────────────────────────────────────
# Get these from https://developer.kcbgroup.com/
AFRINEX_BUNI_CONSUMER_KEY=          # From KCB Developer Portal
AFRINEX_BUNI_CONSUMER_SECRET=       # From KCB Developer Portal
AFRINEX_BUNI_ORG_SHORT_CODE=522522  # Your organisation short code

# ── Global ────────────────────────────────────────────────────────────────────
AFRINEX_CALLBACK_URL=               # e.g. https://myapp.com/webhooks
                                  # SDK appends /daraja /buni automatically

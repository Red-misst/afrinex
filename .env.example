# ── Daraja (Safaricom M-Pesa) ─────────────────────────────────────────────────
LIPAD_DARAJA_CONSUMER_KEY=         # From Safaricom Developer Portal
LIPAD_DARAJA_CONSUMER_SECRET=      # From Safaricom Developer Portal
LIPAD_DARAJA_SHORTCODE=            # Your paybill or till number
LIPAD_DARAJA_PASSKEY=              # STK push passkey from Safaricom portal

# ── Jenga (Equity Bank) ──────────────────────────────────────────────────────
LIPAD_JENGA_API_KEY=               # From Jenga Developer Portal
LIPAD_JENGA_MERCHANT_CODE=         # Your merchant code
LIPAD_JENGA_CONSUMER_SECRET=       # From Jenga Developer Portal
LIPAD_JENGA_PRIVATE_KEY=           # base64-encoded RSA private key PEM
                                   # Leave blank in sandbox — auto-generated

# ── Buni (KCB Bank) ──────────────────────────────────────────────────────────
LIPAD_BUNI_CONSUMER_KEY=           # From KCB Developer Portal
LIPAD_BUNI_CONSUMER_SECRET=        # From KCB Developer Portal
LIPAD_BUNI_ORG_SHORT_CODE=         # Your organisation short code

# ── Global ────────────────────────────────────────────────────────────────────
LIPAD_CALLBACK_URL=                # e.g. https://myapp.com/webhooks
                                   # SDK appends /daraja /jenga /buni automatically
